{
  // Oroboro usage-stats Worker — receives anonymous heartbeats, serves the admin page.
  //
  // One-time setup (see heartbeat-worker/README.md for the full walk-through):
  //   1. npx wrangler kv namespace create STATS   → id is in kv_namespaces below
  //   2. npx wrangler secret put STATS_KEY        → the admin password for /stats
  //   3. npx wrangler deploy
  //
  // Served at https://stats.sailingoroboro.com (custom domain, sailingoroboro.com
  // zone) — this is where anchor-api.js posts (/beat) and the admin page lives (/admin).
  "name": "oroboro-stats",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  // Keep the workers.dev URL alive too, so installs pinned to the old endpoint
  // (v1.5.0 posts to oroboro-stats.<acct>.workers.dev/beat) keep reporting.
  "workers_dev": true,
  "kv_namespaces": [
    { "binding": "STATS", "id": "abfbb113a86e4bc9825bf2661c57a0ad" }
  ],
  "routes": [
    { "pattern": "stats.sailingoroboro.com", "custom_domain": true }
  ]
}
